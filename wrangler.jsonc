{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "randall-automation-works",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "run_worker_first": [
      "/products/raw-workspace/raw-highlight.mp4",
      "/products/raw-workspace/raw-full-demo.mp4"
    ]
  },
  "d1_databases": [{
    "binding": "MARKETING_METRICS",
    "database_name": "raw-marketing-metrics",
    "database_id": "42a6aa4e-c5a0-4b2f-ad94-710fe145393d"
  }],
  "observability": {
    "enabled": true
  },
  "keep_vars": true
}
